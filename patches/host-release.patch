--- /dev/null
+++ b/packages/core/agent/tests/release.spec.ts
@@ -0,0 +1,161 @@
+import { describe, expect, it } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import AgentRegistry from '@deepseek-ai/dsh-agent'
+import SessionStore, { SessionId } from '@deepseek-ai/dsh-session'
+
+import type { Agent, AgentFactory } from '@deepseek-ai/dsh-agent'
+import type { Session } from '@deepseek-ai/dsh-session'
+
+/** Minimal live Agent bound to a session the store already prepared. */
+function stubAgent(session: Session): Agent {
+  return {
+    id: session.id,
+    options: {},
+    session,
+    inbox: { nextTurn: [], nextStep: [] } as never,
+    status: 'idle',
+    ctx: new Context(),
+    send: () => {},
+    followup: () => {},
+    steer: () => ({ outcome: Promise.resolve({ status: 'rejected' as const }) }),
+    inject: () => {},
+    cancel() {},
+    runMaintenance: task => task(new AbortController().signal),
+    whenIdle: () => Promise.resolve(),
+  }
+}
+
+/**
+ * Factory stand-in for the loop: it publishes each agent and session through
+ * the real registries, and every returned handle removes exactly what it
+ * published in the loop's reverse teardown order (agent, then session).
+ * `disposals` records each handle disposal, so a second disposal of one agent
+ * cannot pass unnoticed.
+ */
+function stubFactory(ctx: Context, disposals: SessionId[]): AgentFactory {
+  const publish = (sessionId: SessionId, parentAgent: Agent | undefined) => {
+    const session = ctx.sessions.prepare(sessionId)
+    const agent = stubAgent(session)
+    const detachSession = ctx.sessions.enter(session)
+    const detachAgent = ctx.agents.enter(agent, parentAgent)
+    ctx.sessions.announce(session)
+    ctx.agents.announce(agent)
+    let disposing: Promise<void> | undefined
+    return {
+      agent,
+      dispose: (): Promise<void> => (disposing ??= (async () => {
+        // A real loop teardown is asynchronous; the hop keeps the store
+        // assertions after release() meaningful.
+        await Promise.resolve()
+        disposals.push(sessionId)
+        detachAgent()
+        detachSession()
+      })()),
+    }
+  }
+  return {
+    async createAgent(_ownerCtx, options) {
+      return publish(options.sessionId, options.parentAgent)
+    },
+    async resume(_ownerCtx, options) {
+      return publish(options.resumeSessionId, options.parentAgent)
+    },
+  }
+}
+
+/** Mount the real session store and agent registry with the loop stand-in. */
+async function mountAgentServices(): Promise<{ ctx: Context; disposals: SessionId[] }> {
+  const ctx = new Context()
+  await ctx.plugin(SessionStore)
+  await ctx.plugin(AgentRegistry)
+  const disposals: SessionId[] = []
+  ctx.agents.setFactory(stubFactory(ctx, disposals))
+  return { ctx, disposals }
+}
+
+describe('AgentRegistry.release', () => {
+  it('releases a created agent and empties both stores', async () => {
+    const { ctx, disposals } = await mountAgentServices()
+    const id = SessionId('release-created')
+
+    const handle = await ctx.agents.create({ sessionId: id })
+    expect(ctx.agents.get(id)).toBe(handle.agent)
+    expect(ctx.sessions.get(id)).toBe(handle.agent.session)
+
+    await expect(ctx.agents.release(id)).resolves.toBe(true)
+    expect(ctx.agents.get(id)).toBeUndefined()
+    expect(ctx.sessions.get(id)).toBeUndefined()
+    expect(disposals).toEqual([id])
+
+    await expect(ctx.agents.release(id)).resolves.toBe(false)
+    expect(disposals).toEqual([id])
+  })
+
+  it('releases a resumed agent and claims its capability for one concurrent caller', async () => {
+    const { ctx, disposals } = await mountAgentServices()
+    const id = SessionId('release-resumed')
+
+    const handle = await ctx.agents.resume({ resumeSessionId: id })
+    expect(ctx.agents.get(id)).toBe(handle.agent)
+
+    // release() claims the capability before awaiting its teardown, so the
+    // racing caller finds nothing retained instead of disposing twice.
+    await expect(Promise.all([ctx.agents.release(id), ctx.agents.release(id)]))
+      .resolves.toEqual([true, false])
+    expect(ctx.agents.get(id)).toBeUndefined()
+    expect(ctx.sessions.get(id)).toBeUndefined()
+    expect(disposals).toEqual([id])
+  })
+
+  it('reports false for an agent registered without a handle and for an unknown id', async () => {
+    const { ctx } = await mountAgentServices()
+    const id = SessionId('release-registered')
+    const detach = ctx.agents.register(stubAgent(ctx.sessions.prepare(id)))
+
+    await expect(ctx.agents.release(id)).resolves.toBe(false)
+    await expect(ctx.agents.release(SessionId('release-unknown'))).resolves.toBe(false)
+    expect(ctx.agents.get(id)).toBeDefined()
+
+    detach()
+    expect(ctx.agents.get(id)).toBeUndefined()
+  })
+
+  it('drops the retained capability when the handle disposes the agent first', async () => {
+    const { ctx, disposals } = await mountAgentServices()
+    const id = SessionId('release-other-route')
+
+    const handle = await ctx.agents.create({ sessionId: id })
+    await handle.dispose()
+    expect(ctx.agents.get(id)).toBeUndefined()
+
+    await expect(ctx.agents.release(id)).resolves.toBe(false)
+    expect(disposals).toEqual([id])
+  })
+
+  it('retains nothing when the handle resolves after its entry detached', async () => {
+    const ctx = new Context()
+    await ctx.plugin(SessionStore)
+    await ctx.plugin(AgentRegistry)
+    const id = SessionId('release-detached-first')
+    const session = ctx.sessions.prepare(id)
+    const agent = stubAgent(session)
+    const detachSession = ctx.sessions.enter(session)
+    const detachAgent = ctx.agents.enter(agent, undefined)
+    ctx.sessions.announce(session)
+    ctx.agents.announce(agent)
+    const disposals: SessionId[] = []
+    ctx.agents.setFactory({
+      async createAgent() {
+        detachAgent()
+        detachSession()
+        return { agent, dispose: () => { disposals.push(id); return Promise.resolve() } }
+      },
+      resume: () => Promise.reject(new Error('resume is not exercised by this spec')),
+    })
+
+    await ctx.agents.create({ sessionId: id })
+
+    await expect(ctx.agents.release(id)).resolves.toBe(false)
+    expect(disposals).toEqual([])
+  })
+})
